{
  "manifest_version": 2,
  "id": "wenaixi.mai_planner_timer_scheduler",
  "version": "0.2.0",
  "name": "麦麦规划器延时提醒备忘闹钟",
  "description": "为 planner 提供定时调度能力，支持 relative/absolute/interval/chain 四种模式，多级触发前判定（冷却/活跃/频控），所有行为可配置(无限麦麦)。",
  "author": {
    "name": "Wenaixi",
    "url": "https://github.com/Wenaixi/mai-planner-timer-scheduler"
  },
  "license": "AGPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Wenaixi/mai-planner-timer-scheduler",
    "homepage": "https://github.com/Wenaixi/mai-planner-timer-scheduler#readme",
    "documentation": "https://github.com/Wenaixi/mai-planner-timer-scheduler/blob/main/README.md",
    "issues": "https://github.com/Wenaixi/mai-planner-timer-scheduler/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "capabilities": [
    "send.text",
    "maisaka.proactive.trigger",
    "logger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}